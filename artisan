#!/usr/bin/env php
<?php

$projectPath = __DIR__ . DIRECTORY_SEPARATOR . 'eazibooks-main';
$artisanPath = $projectPath . DIRECTORY_SEPARATOR . 'artisan';

if (! file_exists($artisanPath)) {
    fwrite(STDERR, "Laravel project not found at {$projectPath}." . PHP_EOL);
    exit(1);
}

chdir($projectPath);

require $artisanPath;